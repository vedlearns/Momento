# Template only; never commit real credentials.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=momento
DB_USERNAME=momento_app
DB_PASSWORD=change_me_locally
